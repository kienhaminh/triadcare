# Copy to .env and fill in the empty values. Do not commit .env.

# Agents and judge (OpenRouter).
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_REASONING_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=16384
LLM_TIMEOUT_SECONDS=300

# PostgreSQL (docker/compose.yml). The password must match POSTGRES_PASSWORD.
# Example: postgresql://triadcare:<password>@127.0.0.1:5434/triadcare
DATABASE_URL=
POSTGRES_PASSWORD=

# EHR Agent: HAPI FHIR server root is FHIR_BASE_URL/FHIR_SCOPE.
FHIR_BASE_URL=http://localhost:8090/fhir
FHIR_SCOPE=DEFAULT
FHIR_BEARER_TOKEN=

# Radiologist Agent: MRI inference gateway.
MRI_BASE_URL=http://127.0.0.1:8101
IMAGING_TIMEOUT_SECONDS=300
# Shared secret of the agent and the gateway. Generate a random value.
IMAGING_BEARER_TOKEN=
IMAGING_CATALOG_PATH=scenarios/fixtures/imaging-workflow.json

# CareAgent: search of check-ins by meaning (OpenAI-compatible /embeddings endpoint).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Evaluation judge (src.evaluation.score).
JUDGE_TRANSPORT=openrouter
JUDGE_MODEL=anthropic/claude-haiku-5.5
JUDGE_REASONING_EFFORT=low
